{
  "name": "doltap-wiki-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/cli packages/mcp",
    "test": "vitest run",
    "lint": "tsc -b packages/core packages/cli packages/mcp --noEmit",
    "doltap": "node packages/cli/dist/main.js",
    "publish:all": "tools/publish.sh",
    "reference": "node packages/mcp/dist/main.js --reference > docs/TOOLS.md",
    "reference:check": "node packages/mcp/dist/main.js --reference --check docs/TOOLS.md"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluekds/doltap-wiki.git"
  },
  "version": "0.10.0"
}
